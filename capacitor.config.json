{
  "appId": "com.mahmadsoni.qrvault",
  "appName": "QR Vault",
  "webDir": "web",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0a0e17"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0a0e17",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
